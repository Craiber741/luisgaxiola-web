Options -Indexes

# Prevent Cloudflare/browsers from caching HTML pages
<IfModule mod_headers.c>
  <FilesMatch "\.(html|htm)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>
</IfModule>

RewriteEngine On

# Landings retiradas (oct-2026): el sitio quedó en newsletters + asesoría 1 a 1.
# Van antes de servir archivos para ganarle a HTML viejo que quede en el servidor.
RewriteRule ^demos/(privacidad|terminos)(\.html|/)?$ /privacidad [R=301,L]
RewriteRule ^servicios/(consultoria|mentoria)(\.html|/)?$ /asesoria [R=301,L]
RewriteRule ^servicios(\.html|/)?$ /asesoria [R=301,L]
RewriteRule ^(easy|web|webs|web2|servicios/media-buying)(\.html|/)?$ https://craiber.com/ [R=301,L]
RewriteRule ^demos(/.*)?$ https://craiber.com/ [R=301,L]

# Serve existing files directly (CSS, JS, images, etc.)
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^ - [L]

# Try path.html first (Next.js static export: /web → web.html)
RewriteCond %{DOCUMENT_ROOT}%{REQUEST_URI}.html -f
RewriteRule ^(.+?)/?$ $1.html [L]

# Then try path/index.html
RewriteCond %{DOCUMENT_ROOT}%{REQUEST_URI}/index.html -f
RewriteRule ^(.+?)/?$ $1/index.html [L]
